{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokyo-budget-simulator",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_GLOBAL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AI_CLIENT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
